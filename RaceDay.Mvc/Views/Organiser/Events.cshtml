@model List<RaceDay.Contracts.EventDto>
@{
    ViewData["Title"] = "My events";
    var venueNames = (Dictionary<int, string>)ViewBag.VenueNames;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">My events</h1>
    <a asp-action="CreateEvent" class="btn btn-success">+ Create event</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">You have not created any events yet.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr><th>Name</th><th>Date</th><th>Type</th><th>Distance</th><th>Venue</th><th class="text-end">Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td>@e.EventName</td>
                    <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                    <td>@e.EventType</td>
                    <td>@e.Distance km</td>
                    <td>@(venueNames.TryGetValue(e.VenueId, out var vn) ? vn : "-")</td>
                    <td class="text-end">
                        <a asp-action="Categories" asp-route-eventId="@e.EventId" class="btn btn-sm btn-outline-secondary">Categories</a>
                        <a asp-action="EditEvent" asp-route-id="@e.EventId" class="btn btn-sm btn-outline-primary">Edit</a>
                        <form asp-action="DeleteEvent" asp-route-id="@e.EventId" method="post" class="d-inline"
                              onsubmit="return confirm('Delete this event? This cannot be undone.');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}