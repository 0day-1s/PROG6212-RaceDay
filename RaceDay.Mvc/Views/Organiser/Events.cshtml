@model List<RaceDay.Contracts.EventDto>
@{
    ViewData["Title"] = "My events";
    var venueNames = (Dictionary<int, string>)ViewBag.VenueNames;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">My events</h1>
    <a asp-action="CreateEvent" class="btn btn-success">+ Create event</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">You have not created any events yet.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr><th>Name</th><th>Date</th><th>Type</th><th>Distance</th><th>Venue</th></tr>
        </thead>
        <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td>@e.EventName</td>
                    <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                    <td>@e.EventType</td>
                    <td>@e.Distance km</td>
                    <td>@(venueNames.TryGetValue(e.VenueId, out var vn) ? vn : "-")</td>
                </tr>
            }
        </tbody>
    </table>
}