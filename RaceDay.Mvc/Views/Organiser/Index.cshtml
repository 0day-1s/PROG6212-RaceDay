@model RaceDay.Mvc.ViewModels.OrganiserDashboardVm
@{
    ViewData["Title"] = "Dashboard";
}

<h1 class="mb-4">Organiser dashboard</h1>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <div class="display-6">@Model.TotalEvents</div><div class="text-muted">Your events</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <div class="display-6">@Model.TotalEnrolments</div><div class="text-muted">Total enrolments</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                @if (Model.NextEvent != null)
                {
                    <div class="fs-5 fw-bold">@Model.NextEvent.Name</div>
                    <div class="text-muted">Next event: @Model.NextEvent.EventDate.ToString("dd MMM yyyy")</div>
                }
                else
                {
                    <div class="text-muted">No upcoming events</div>
                }
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h2 class="h4 mb-0">Enrolments per event</h2>
    <a asp-action="CreateEvent" class="btn btn-success">+ Create event</a>
</div>

@if (!Model.Events.Any())
{
    <div class="alert alert-info">You have not created any events yet.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead><tr><th>Event</th><th>Date</th><th>Enrolments</th><th></th></tr></thead>
        <tbody>
            @foreach (var e in Model.Events)
            {
                <tr>
                    <td>@e.Name</td>
                    <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                    <td><span class="badge bg-dark">@e.EnrolmentCount</span></td>
                    <td>
                        @if (e.EventDate.Date >= DateTime.Today)
                        {
                            <span class="badge bg-success">Upcoming</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Past</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}