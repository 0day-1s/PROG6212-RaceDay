@model RaceDay.Mvc.ViewModels.EventFormVm
@{
    ViewData["Title"] = "Create event";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <h1 class="mb-3">Create event</h1>
        <form asp-action="CreateEvent" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="EventName" class="form-label"></label>
                <input asp-for="EventName" class="form-control" />
                <span asp-validation-for="EventName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="EventDate" class="form-label"></label>
                    <input asp-for="EventDate" type="date" class="form-control" />
                    <span asp-validation-for="EventDate" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="EventType" class="form-label"></label>
                    <select asp-for="EventType" class="form-select">
                        <option value="Run">Run</option>
                        <option value="Walk">Walk</option>
                        <option value="Cycle">Cycle</option>
                    </select>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Distance" class="form-label"></label>
                    <input asp-for="Distance" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="Distance" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="VenueId" class="form-label"></label>
                    <select asp-for="VenueId" class="form-select">
                        <option value="0">-- Choose a venue --</option>
                        @foreach (var v in Model.Venues)
                        {
                            <option value="@v.VenueId">@v.VenueName (@v.City)</option>
                        }
                    </select>
                    <span asp-validation-for="VenueId" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-success">Create event</button>
            <a asp-action="Events" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}