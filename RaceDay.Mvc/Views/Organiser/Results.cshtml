@model RaceDay.Mvc.ViewModels.ResultsPageVm
@{
    ViewData["Title"] = "Results";
}

<h1 class="mb-3">Results</h1>

@if (!Model.Events.Any())
{
    <div class="alert alert-info">Create an event first to capture results.</div>
}
else
{
    <form method="get" asp-action="Results" class="row g-2 mb-4">
        <div class="col-md-6">
            <select name="eventId" class="form-select" onchange="this.form.submit()">
                @foreach (var ev in Model.Events)
                {
                    <option value="@ev.EventId" selected="@(ev.EventId == Model.SelectedEventId)">
                        @ev.EventName (@ev.EventDate.ToString("dd MMM yyyy"))
                    </option>
                }
            </select>
        </div>
    </form>

    <h2 class="h4">Captured results</h2>
    @if (!Model.Results.Any())
    {
        <div class="alert alert-info">No results captured for this event yet.</div>
    }
    else
    {
        <table class="table table-striped align-middle mb-4">
            <thead>
                <tr><th>Position</th><th>Participant</th><th>Category</th><th>Finish time</th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Results)
                {
                    <tr>
                        <td><span class="badge bg-dark">@r.FinishPosition</span></td>
                        <td>@r.ParticipantName</td>
                        <td>@r.CategoryName</td>
                        <td>@r.FinishTime.ToString(@"hh\:mm\:ss")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h2 class="h4">Awaiting results</h2>
    @if (!Model.Awaiting.Any())
    {
        <div class="alert alert-secondary">No enrolled participants are waiting for a result.</div>
    }
    else
    {
        <table class="table align-middle">
            <thead>
                <tr><th>Participant</th><th>Category</th><th>Status</th><th>Finish time (hh:mm:ss)</th><th>Position</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var en in Model.Awaiting)
                {
                    var formId = "capture-" + en.EnrolmentId;
                    <tr>
                        <td>@(en.ParticipantName ?? ("Participant #" + en.ParticipantId))</td>
                        <td>@en.CategoryName</td>
                        <td><partial name="_StatusBadge" model="en.EnrolmentStatus" /></td>
                        <td>
                            <input name="finishTime" form="@formId" class="form-control form-control-sm"
                                   placeholder="00:45:30" pattern="\d{1,2}:\d{2}:\d{2}" required />
                        </td>
                        <td>
                            <input name="finishPosition" form="@formId" type="number" min="1"
                                   class="form-control form-control-sm" required />
                        </td>
                        <td>
                            <form id="@formId" asp-action="CaptureResult" method="post">
                                <input type="hidden" name="eventId" value="@en.EventId" />
                                <input type="hidden" name="enrolmentId" value="@en.EnrolmentId" />
                                <button type="submit" class="btn btn-sm btn-success">Save</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}