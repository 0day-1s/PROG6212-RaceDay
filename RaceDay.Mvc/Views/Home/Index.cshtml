@{
    ViewData["Title"] = "Home";
    var name = Context.Session.GetString("DisplayName");
    var role = Context.Session.GetString("Role");
}

<div class="text-center py-5">
    <h1 class="display-4 fw-bold">RaceDay</h1>
    <p class="lead">Run, walk and cycle events across South Africa.</p>
    @if (name != null)
    {
        <p class="fs-5">Welcome back, <strong>@name</strong> (@role).</p>
    }
    else
    {
        <a asp-controller="Auth" asp-action="Register" class="btn btn-success btn-lg me-2">Get started</a>
        <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-dark btn-lg">Log in</a>
    }
</div>