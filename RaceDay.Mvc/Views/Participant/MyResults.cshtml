@model List<RaceDay.Contracts.ResultDto>
@{
    ViewData["Title"] = "My results";
}

<h1 class="mb-3">My results</h1>

@if (!Model.Any())
{
    <div class="alert alert-info">You have no results yet. Results appear here after an organiser captures them.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th></tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.EventName</td>
                    <td>@(r.EventDate?.ToString("dd MMM yyyy"))</td>
                    <td>@r.CategoryName</td>
                    <td>@r.FinishTime.ToString(@"hh\:mm\:ss")</td>
                    <td>
                        <span class="badge bg-dark">@r.FinishPosition</span>
                        @if (r.TotalFinishers != null)
                        {
                            <span class="text-muted">of @r.TotalFinishers</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}