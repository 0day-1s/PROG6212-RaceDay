@model RaceDay.Mvc.ViewModels.EventDetailsVm
@{
    ViewData["Title"] = Model.Event.EventName;
}

<a asp-action="Index" class="btn btn-link ps-0">&larr; Back to events</a>

<div class="row g-4">
    <div class="col-md-8">
        @if (!string.IsNullOrWhiteSpace(Model.Event.BannerImageUrl))
        {
            <img src="@Url.Action("Show", "Images", new { url = Model.Event.BannerImageUrl })" alt="@Model.Event.EventName banner" class="img-fluid rounded mb-3" />
        }
        <span class="badge bg-success mb-2">@Model.Event.EventType</span>
        <h1>@Model.Event.EventName</h1>
        <p>@Model.Event.Description</p>
        <ul class="list-unstyled text-muted">
            <li><strong>Date:</strong> @Model.Event.EventDate.ToString("dd MMM yyyy")</li>
            <li><strong>Distance:</strong> @Model.Event.Distance km</li>
            <li><strong>Venue:</strong> @Model.VenueName</li>
        </ul>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                @if (Model.MyEnrolment != null)
                {
                    <h2 class="h5">Your entry</h2>
                    <p class="mb-1">Category: <strong>@Model.MyEnrolment.CategoryName</strong></p>
                    <p>Status: <partial name="_StatusBadge" model="Model.MyEnrolment.EnrolmentStatus" /></p>
                }
                else if (Model.Event.EventDate.Date < DateTime.Today)
                {
                    <div class="alert alert-secondary mb-0">This event has already taken place.</div>
                }
                else if (!Model.Categories.Any())
                {
                    <div class="alert alert-info mb-0">The organiser has not added categories yet.</div>
                }
                else
                {
                    <h2 class="h5">Enter this event</h2>
                    <form asp-action="EnterEvent" method="post">
                        <input type="hidden" name="eventId" value="@Model.Event.EventId" />
                        <div class="mb-3">
                            <label class="form-label">Choose a category</label>
                            <select name="categoryId" class="form-select" required>
                                @foreach (var c in Model.Categories)
                                {
                                    <option value="@c.CategoryId">@c.CategoryName</option>
                                }
                            </select>
                        </div>
                        <button type="submit" class="btn btn-success w-100">Enter event</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>